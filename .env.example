# Correo del formulario de contacto. Sin esto, /api/contacto responde 503 y el
# formulario ofrece el correo directo como alternativa.
NUXT_SMTP_HOST=smtp.gmail.com
NUXT_SMTP_PUERTO=587
NUXT_SMTP_USUARIO=tu-correo@gmail.com
# En Gmail es una contraseña de aplicación, no la del correo.
NUXT_SMTP_CLAVE=
NUXT_CORREO_DESTINO=camiloarinconc@gmail.com

# URL pública, para canonical y sitemap.
NUXT_PUBLIC_SITE_URL=https://camilorincon.dev
