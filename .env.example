# ── Correo del formulario de contacto ────────────────────────────────────────
# Sin esto, /api/contacto responde 503 y el formulario ofrece el correo directo
# como alternativa. Degrada bien, pero no envía.
#
# Con Brevo (antes Sendinblue), plan gratuito de 300 correos al día:
#   1. Crea la cuenta en brevo.com y verifica tu correo.
#   2. Entra en SMTP & API → SMTP.
#   3. Ahí salen el "Login" (algo como 8a1b2c001@smtp-brevo.com) y el botón
#      para generar una "SMTP key". La key se muestra UNA sola vez.
#   4. Pega los dos valores aquí abajo.
#
# El login NO es tu correo de Brevo: es el que aparece en esa pantalla.
#
# Y el host NO es el que muestra la consola. Brevo dice `smtp-relay.brevo.com`,
# pero su certificado TLS sigue a nombre de Sendinblue, así que ese hostname no
# valida y la conexión se rechaza. Se usa `smtp-relay.sendinblue.com`.
NUXT_SMTP_HOST=smtp-relay.sendinblue.com
NUXT_SMTP_PUERTO=587
NUXT_SMTP_USUARIO=
NUXT_SMTP_CLAVE=
# A dónde llegan los mensajes del formulario.
NUXT_CORREO_DESTINO=camiloarinconc@gmail.com

# ── Sitio ────────────────────────────────────────────────────────────────────
# Remitente. TIENE que ser una dirección verificada en Brevo
# (Remitentes, dominio, IP → Remitentes). NO es el login SMTP: con el login,
# Brevo devuelve éxito y descarta el mensaje sin registrarlo en ninguna parte.
NUXT_CORREO_REMITENTE=

# URL pública, para canonical, sitemap y Open Graph.
NUXT_PUBLIC_SITE_URL=https://camilorincon.dev
